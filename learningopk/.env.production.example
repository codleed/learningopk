# Production Environment Variables
# Copy this file to .env and fill in the actual values
# DO NOT commit the actual .env file to git

# Database
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_RDS_ENDPOINT:5432/learningo

# Redis
REDIS_URL=redis://YOUR_ELASTICACHE_ENDPOINT:6379

# Authentication
BETTER_AUTH_SECRET=YOUR_BETTER_AUTH_SECRET
BETTER_AUTH_URL=http://localhost:3001

# Frontend
FRONTEND_ORIGIN=https://yourdomain.com

# AI
MISTRAL_API_KEY=YOUR_MISTRAL_API_KEY

# S3/MinIO Storage
MINIO_ENDPOINT=YOUR_S3_ENDPOINT
MINIO_PORT=9000
MINIO_USE_SSL=true
MINIO_ACCESS_KEY=YOUR_ACCESS_KEY
MINIO_SECRET_KEY=YOUR_SECRET_KEY
MINIO_BUCKET=learningo-media
MINIO_PUBLIC_URL=https://your-s3-bucket.s3.amazonaws.com

# Server
PORT=3001
NODE_ENV=production

# Monitoring (optional)
SENTRY_DSN=YOUR_SENTRY_DSN

# Rate Limiting
REDIS_RATE_LIMIT_URL=redis://YOUR_ELASTICACHE_ENDPOINT:6379
