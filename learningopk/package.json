{
  "name": "learningopk",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["frontend", "backend", "packages/shared"],
  "scripts": {
    "dev:frontend": "npm --workspace frontend run dev",
    "dev:backend": "npm --workspace backend run dev",
    "dev:all": "concurrently -n frontend,backend -c blue,green \"npm run dev:frontend\" \"npm run dev:backend\"",
    "lint": "npm --workspaces --if-present run lint",
    "typecheck": "npm --workspaces --if-present run typecheck",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:clear": "npm --workspace backend run db:clear",
    "db:seed": "npm --workspace backend run db:seed",
    "verify:services": "npm --workspace backend run healthcheck"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.4"
  },
  "overrides": {
    "path-to-regexp": "8.4.0",
    "fast-xml-parser": "5.5.7",
    "lodash": "4.17.21",
    "cookie": "0.7.2",
    "minimatch": "10.2.5",
    "brace-expansion": "5.0.5",
    "flatted": "3.4.2",
    "hono": "4.12.14",
    "@hono/node-server": "1.19.14",
    "express-rate-limit": "8.3.2",
    "defu": "6.1.5",
    "esbuild": "0.25.0"
  }
}
